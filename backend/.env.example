# Copia este archivo como .env y completa los valores.
PORT=3000
NODE_ENV=development
# Desde tu PC usa la URL externa de la base de datos (por ejemplo, la de Neon).
DATABASE_URL=postgresql://usuario:contrasena@servidor/base?sslmode=verify-full
PGSSLMODE=require
CORS_ORIGIN=http://localhost:4200
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
